# Másold .env néven helyi fejlesztéshez, vagy vedd fel ezeket a hoszting környezeti változói közé.
# Valódi kulcsot, jelszót vagy adatbázis-URL-t ne tölts fel a gitbe.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js – legalább 32 karakteres, véletlenszerű titok
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="https://your-domain.hu"
NEXTAUTH_URL="https://your-domain.hu"
NEXT_PUBLIC_APP_URL="https://your-domain.hu"

# Resend – hitelesített feladói domain szükséges éles küldéshez
RESEND_API_KEY="re_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Az /api/cron/reminders végpont védelméhez. Legalább 32 véletlenszerű karakter.
CRON_SECRET="replace-with-a-second-long-random-secret"
